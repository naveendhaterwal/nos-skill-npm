{
  "version": "0.1",
  "type": "container",
  "meta": {
    "system_requirements": {
      "required_vram": 16
    }
  },
  "ops": [
    {
      "id": "webui",
      "type": "container/run",
      "args": {
        "image": "ghcr.io/open-webui/open-webui:ollama",
        "env": {
          "WEBUI_AUTH": "False",
          "WEBUI_NAME": "Nosana Chat"
        },
        "gpu": true,
        "expose": 8080
      }
    }
  ]
}
